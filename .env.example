# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. NEVER put secret values here; secrets live in
# Google Cloud Secret Manager and are fetched at runtime (gf_agent/config.py).

# --- Google Cloud (non-secret) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-argolis-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Gemini models are served from the global location in this project.
GF_MODEL_LOCATION=global

# Agent Runtime (Agent Engine) resource ID for managed Sessions + Memory Bank.
# Leave empty for offline local dev (SQLite sessions, in-memory memory).
GF_AGENT_ENGINE_ID=

# --- Model routing (override per environment; verify availability in Model Garden) ---
GF_MODEL_LITE=gemini-3.5-flash-lite
GF_MODEL_FAST=gemini-3.5-flash
GF_MODEL_PRO=gemini-3.1-pro-preview

# --- Security features ---
GF_ENABLE_CLOUD_DLP=false
# Full Model Armor template resource name, e.g.
# projects/PROJECT/locations/us-central1/templates/gf-agent-template
GF_MODEL_ARMOR_TEMPLATE=
# Secret Manager secret ID (the ID, not the value) for the log pseudonymisation salt.
GF_PII_SALT_SECRET_ID=gf-agent-pii-hash-salt

# --- Observability ---
GF_ENABLE_CLOUD_TRACE=false
GF_LOG_LEVEL=INFO

# --- Optional live web search for retailers (Google Search grounding) ---
GF_ENABLE_LIVE_SEARCH=false
