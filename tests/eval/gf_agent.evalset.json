      "evalId": "quick_check_gf_oats_australia",
      "conversation": [
        {
          "invocationId": "quick_check_gf_oats_australia-1",
          "userContent": {
            "parts": [
              {
                "text": "In Australia, is a muesli with gluten-free oats, rice puffs and honey OK to call gluten free?"
              }
            ],
            "role": "user"
          },
          "finalResponse": {
            "parts": [
              {
                "text": "No. In Australia (FSANZ Food Standards Code) oats, including 'gluten-free' oats, are not permitted in gluten-free claims, so this product is EXCLUDED. Please check the label."
              }
            ],
            "role": "model"
          },
          "intermediateData": {
            "toolUses": [
              {
                "args": {},
                "name": "check_ingredients_for_gluten_sources"
              }
            ],
            "toolResponses": [],
            "intermediateResponses": []
          },
          "creationTimestamp": 0.0
        }
      ],
      "creationTimestamp": 0.0,
      "rubrics": [
        {
          "rubricId": "quick_check_gf_oats_australia-r1",
          "rubricContent": {
            "textProperty": "Says oats are not permitted in Australian gluten-free claims."
          }
        },
        {
          "rubricId": "quick_check_gf_oats_australia-r2",
          "rubricContent": {
            "textProperty": "Cites FSANZ / the Australia New Zealand Food Standards Code."
          }
        },
        {
          "rubricId": "quick_check_gf_oats_australia-r3",
          "rubricContent": {
            "textProperty": "Does not recommend the product as gluten-free."
